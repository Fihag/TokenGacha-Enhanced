{
  "name": "tokengacha",
  "version": "4.1.1",
  "description": "TokenGacha · LLM API 抽卡模拟器 - 纯前端无构建版",
  "type": "module",
  "scripts": {
    "dev": "npx serve .",
    "serve": "npx serve . -l 8123",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.3",
    "vitest": "^1.6.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
